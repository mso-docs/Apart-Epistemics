# Copy to .env (git-ignored) and fill in. Never commit real values.

# --- Hugging Face (only needed for gated assets; Phi-3.5-mini, SQuAD 2.0 and SelfAware are public) ---
HF_TOKEN=
HF_HOME=./hf_cache

# --- Paid API calls (judge hook, optional). OFF by default. Budget: $30 total for Apart. ---
OPENROUTER_API_KEY=
APART_ALLOW_PAID_CALLS=0
APART_OPENROUTER_BUDGET_USD=30
APART_OPENROUTER_LEDGER=~/.local/share/openrouter-budget/apart_spend.jsonl
# Folder that contains openrouter_budget.py (standalone spend guard)
APART_BUDGET_MODULE_DIR=~/Documents/code/tools/openrouter-budget
APART_RUN_ID=

# --- Model host (8 GB GPU server). SSH alias from ~/.ssh/config; nothing secret here. ---
APART_REMOTE_HOST=model-host
APART_REMOTE_DIR=~/apart-epistemics

# --- Evalboard (local, loopback only) ---
APART_EVALBOARD_URL=http://127.0.0.1:8767

# --- 8 GB server address (optional override) ---
# Paste the server's SSH target here, e.g. user@100.x.y.z or user@my-server.tailnet.ts.net.
# Leave blank to use the APART_REMOTE_HOST alias from ~/.ssh/config (see your own ssh config).
APART_REMOTE_SSH=
